{"result": [[{"id": 3587, "sub_id": 59, "type": "E-def", "text": "snakke", "index": null, "pri_id": 3587, "pri_text": "snakke"}, {"id": 4820, "sub_id": 2, "type": "E-lem", "text": "snakke", "index": null, "pri_id": 4820, "pri_text": "snakke"}, {"id": 1455, "sub_id": 19, "type": "Ru-lem", "text": "проговориться", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 47, "type": "Ru-kat", "text": "глагол.", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 60, "type": "E-def", "text": "avsløre en hemmeliget ved en feiltakelse", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 63, "type": "B-def", "text": "let out a secret by mistake", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 77, "type": "Ru-def", "text": "проболтаться", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 89, "type": "N-eks", "text": "jeg forsnakket meg", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 92, "type": "B-eks", "text": "I let the cat out of the bag", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 106, "type": "Ru-eks", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 120, "type": "E-mor", "text": "-snakker -snakket (el -snakka) -snakket (el -snakka)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 1455, "sub_id": 125, "type": "E-utt", "text": "fårsn.ake sæ\\\\i", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 2, "type": "E-lem", "text": "nevne", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 5, "type": "B-lem", "text": "mention", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 19, "type": "Ru-lem", "text": "упоминать/упомянуть, отмечать/отметить", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 47, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 60, "type": "E-def", "text": "snakke (forbigående) om", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 63, "type": "B-def", "text": "talk about, refer to (in passing)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 77, "type": "Ru-def", "text": "сказать (мимоходом) о чём-либо", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 90, "type": "E-eks", "text": "det bør nevnes at Borg var forkjølt under kampen", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 93, "type": "B-eks", "text": "it is worth mentioning that Borg had a cold at the time of the match", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 107, "type": "Ru-eks", "text": "следует упомянуть, что во время матча у Борга была простуда", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 122, "type": "E-eks", "text": "han slo Connors og Fibak, for å nevne noen", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 125, "type": "B-eks", "text": "he beat Connors and Fibak, to name just a few", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 139, "type": "Ru-eks", "text": "он победил, в частности, Коннорса и Фибака", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 154, "type": "N-idi", "text": "ingen nevnt, ingen glemt (alle fortjener like stor takk)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 157, "type": "B-idi", "text": "nobody mentioned, nobody forgotten", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 171, "type": "Ru-idi", "text": "никто не забыт (спасибо всем, кто принял участие)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 183, "type": "N-idi", "text": "nevne noe ved dets rette navn (si noe slik det virkelig er)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 186, "type": "B-idi", "text": "call a spade a spade", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 200, "type": "Ru-idi", "text": "называть вещи своими именами (говорить о чём-либо прямо, как есть)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 217, "type": "E-mor", "text": "å nevne nevner nevnte har nevnt", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3251, "sub_id": 222, "type": "E-utt", "text": "nevne", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 2, "type": "E-lem", "text": "prate", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 4, "type": "B-lem", "text": "talk, chat", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 18, "type": "Ru-lem", "text": "говорить, болтать", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 31, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 32, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 46, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 61, "type": "B-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 75, "type": "Ru-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 88, "type": "E-eks", "text": "hun bare prater i vei", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 90, "type": "B-eks", "text": "she just goes on talking", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 104, "type": "Ru-eks", "text": "она говорит без умолку", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 118, "type": "E-eks", "text": "jeg pratet med henne i går", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 120, "type": "B-eks", "text": "I talked with (spoke to) her yesterday", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 134, "type": "Ru-eks", "text": "я говорил с ней вчера", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 151, "type": "E-mor", "text": "prater pratet (el prata) pratet (el prata)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 3587, "sub_id": 155, "type": "E-utt", "text": "pra:te", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 5, "type": "B-lem", "text": "speak, talk", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 19, "type": "Ru-lem", "text": "говорить/поговорить, разговаривать", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 47, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 60, "type": "E-def", "text": "kommunisere muntlig, prate, ytre seg", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 63, "type": "B-def", "text": "communicate verbally, chat, express oneself", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 77, "type": "Ru-def", "text": "общаться устно, беседовать, высказываться", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 90, "type": "E-eks", "text": "hun snakker svensk", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 93, "type": "B-eks", "text": "she speaks Swedish", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 107, "type": "Ru-eks", "text": "она говорит по-шведски", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 121, "type": "E-eks", "text": "snakke med hverandre", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 124, "type": "B-eks", "text": "talk with each other", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 138, "type": "Ru-eks", "text": "говорить/разговаривать друг с другом", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 152, "type": "E-eks", "text": "snakke sammen", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 155, "type": "B-eks", "text": "talk about something, talk something over", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 169, "type": "Ru-eks", "text": "поговорить (друг с другом), переговорить, разговаривать (друг с другом)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 183, "type": "E-eks", "text": "høre snakk om noe", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 186, "type": "B-eks", "text": "hear (talk) of something", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 200, "type": "Ru-eks", "text": "услышать о чём-либо, слышать разговоры о чём-либо", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 219, "type": "B-idi", "text": "tell (relate)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 222, "type": "E-idi", "text": "snakke ut (si akkurat det man mener)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 225, "type": "B-idi", "text": "speak out (voice one's true opinion)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 239, "type": "Ru-idi", "text": "высказывать, разъяснять свою точку зрения, выговариваться, высказываться", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 252, "type": "N-idi", "text": "snakke forbi hverandre (misforstå hverandre)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 255, "type": "B-idi", "text": "talk at cross purposes (misunderstand each other)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 269, "type": "Ru-idi", "text": "не понимать друг друга", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 281, "type": "N-idi", "text": "(vi) snakkes! (på onsdag) (ser deg (på onsdag)!)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 284, "type": "B-idi", "text": "I'll be seeing you! (on Wednesday) (see you later! talk to you later!)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 298, "type": "Ru-idi", "text": "встретимся в среду! (до встречи! до связи!)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 310, "type": "N-idi", "text": "snakke i gåter (snakke slik at andre ikke forstår hva man egentlig mener)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 313, "type": "B-idi", "text": "speak in riddles", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 327, "type": "Ru-idi", "text": "говорить загадками (говорить так, чтобы окружающие не поняли, что ты имеешь в виду)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 344, "type": "E-mor", "text": "å snakke snakker snakket (snakka) har snakket (har snakka)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 4820, "sub_id": 349, "type": "E-utt", "text": "snake", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 2, "type": "E-lem", "text": "pludre", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 5, "type": "B-lem", "text": "babble", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 19, "type": "Ru-lem", "text": "агукать", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 47, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 60, "type": "E-def", "text": "snakke utydelig, bable", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 63, "type": "B-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 77, "type": "Ru-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 89, "type": "N-eks", "text": "babyen pludret fornøyd", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 92, "type": "B-eks", "text": "the baby was babbling happily", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 106, "type": "Ru-eks", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 120, "type": "E-mor", "text": "pludrer pludret (el pludra) pludret (el pludra)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 9007, "sub_id": 125, "type": "E-utt", "text": "pludre", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 2, "type": "E-lem", "text": "mumle", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 5, "type": "B-lem", "text": "mumble", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 19, "type": "Ru-lem", "text": "бормотать", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 47, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 60, "type": "E-def", "text": "snakke lavt og utydelig", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 63, "type": "B-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 77, "type": "Ru-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 90, "type": "E-eks", "text": "han mumlet en takk og forsvant", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 93, "type": "B-eks", "text": "he mumbled his thanks and disappeared", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 107, "type": "Ru-eks", "text": "он пробормотал спасибо и исчез", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 122, "type": "E-mor", "text": "mumler mumlet (el mumla) mumlet (el mumla)", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10325, "sub_id": 127, "type": "E-utt", "text": "momle", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 2, "type": "E-lem", "text": "omtale", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 5, "type": "B-lem", "text": "talk about, speak of, mention; review", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 19, "type": "Ru-lem", "text": "упоминать/упомянуть, называть/назвать; давать/дать отзыв", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 47, "type": "Ru-kat", "text": "глагол", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 60, "type": "E-def", "text": "snakke om, fortelle; anmelde", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 63, "type": "B-def", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 77, "type": "Ru-def", "text": "рассказывать о чём-либо; рецензировать что-либо", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 89, "type": "B-alt", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 90, "type": "N-eks", "text": "han var ikke engang omtalt i boka", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 93, "type": "B-eks", "text": "he wasn't even mentioned in the book", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 107, "type": "Ru-eks", "text": "он даже не был упомянут в книге", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 122, "type": "E-mor", "text": "omtaler omtalte (el omtala) omtalt (el omtala)|omtaler omtalte omtalt", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 127, "type": "E-utt", "text": "'åmta:le", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 131, "type": "E-grm", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 134, "type": "B-grm", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 10607, "sub_id": 148, "type": "Ru-grm", "text": "", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 2, "type": "E-lem", "text": "anbefale", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 4, "type": "B-lem", "text": "recommend", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 18, "type": "Ru-lem", "text": "рекомендовать/порекомендовать", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 29, "type": "N-kom", "text": "pol-2", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 32, "type": "E-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 33, "type": "B-kat", "text": "verb", "index": null, "pri_id": null, "pri_text": ""}, {"id": 11292, "sub_id": 47, "type": "Ru-kat", "text": "гла